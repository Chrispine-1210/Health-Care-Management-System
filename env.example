NODE_ENV=development
PORT=5000
JWT_SECRET=change-this-to-a-long-random-production-secret
PATIENT_DATA_ENCRYPTION_KEY=change-this-to-a-separate-long-random-encryption-key
LOG_LEVEL=debug
DATABASE_URL=postgresql://user:password@localhost:5432/thandizo
# Optional explicit override when integration-managed aliases retain older credentials.
THANDIZO_DATABASE_URL=
USE_DATABASE_STORAGE=true
# Opt-in synthetic local fixtures only; never enable on production.
SEED_TEST_DATA=false
DB_POOL_MAX=10

# Frontend -> API configuration. In Vercel production, set this to the HTTPS API host.
VITE_API_BASE_URL=http://localhost:5000

# Backend CORS allow-list for Vercel/Cloudflare custom domains. Comma-separated.
FRONTEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,https://your-domain.example,https://www.your-domain.example

# Optional production integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_API_KEY=
